TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CRAWL_INTERVAL_MINUTES=20

REQUEST_TIMEOUT=15

MAX_RETRIES=3

INITIAL_SCAN_SEND=false

LOG_LEVEL=INFO

TIMEZONE=Asia/Ho_Chi_Minh

STALE_SOURCE_HOURS=24

STALE_ALERT_COOLDOWN_HOURS=24

BACKUP_KEEP_DAYS=14

# Public URL of the Cloudflare Worker backing the website's "Quét
# ngay" button (see web/cloudflare-worker/). Leave empty to simply not
# show the button. Not a secret — the GitHub token that actually
# triggers a crawl lives only in the Worker's own environment.
NEWS_SCAN_WORKER_URL=

# Brand monitoring / crisis alerts (web/brandwatch.py). Alert when strong-
# negative headlines about ONE brand come from >= CRISIS_MIN_SOURCES distinct
# outlets within CRISIS_WINDOW_MINUTES; then stay quiet for the cooldown.
# Own brand / competitors live in watchlist.json (WATCHLIST_PATH to override).
CRISIS_MIN_SOURCES=3
CRISIS_WINDOW_MINUTES=60
CRISIS_COOLDOWN_HOURS=3

# SignalScore's Source Weight component (roadmap V2 §14, web/source_
# registry.py). Missing file/entries default to tier A / weight 1.0.
# SOURCE_REGISTRY_PATH=

# Signal Alert (roadmap V3 §26): a dedicated Telegram message, rarer and
# higher-bar than the regular "TOP TÍN HIỆU" section, for an issue that
# just started accelerating with enough source diversity and score.
SIGNAL_ALERT_MIN_SOURCES=3
SIGNAL_ALERT_MIN_SCORE=70

# Personal Watchlist (roadmap V4 §29-34): a PRIVATE, local-only,
# Telegram-only list of entities you personally want to be pinged
# about — see personal_watchlist.example.json. Copy that file to
# personal_watchlist.json (gitignored, never committed) to enable this;
# leave unset to disable it entirely.
# PERSONAL_WATCHLIST_PATH=
# Same content as that file but inline — what GitHub Actions uses (a repository
# Secret named PERSONAL_WATCHLIST_JSON). Wins over the file when non-empty.
# PERSONAL_WATCHLIST_JSON=
